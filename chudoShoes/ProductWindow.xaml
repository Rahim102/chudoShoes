<Window x:Class="chudoShoes.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:chudoShoes"
        mc:Ignorable="d"
        Title="Продукты" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Left"
              Name="AdmPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="20 0" Grid.Column="0">
                <TextBlock Text="Поиск"/>
                <TextBox Name="SearchingTB"
                         Width="200"
                       TextChanged="SearchingTB_TextChanged" />
            </StackPanel>
            <StackPanel Margin="20 0" Grid.Column="1">
                <TextBlock Text="Сортировка"/>
                <ComboBox Name="SortingCB"
                 Width="200"
                          SelectionChanged="SortingCB_SelectionChanged"/>
            </StackPanel>
            <StackPanel Margin="20 0" Grid.Column="2">
                <TextBlock Text="Фильтрация"/>
                <ComboBox Name="FilteringCB"
                          Width="200"
                          SelectionChanged="FilteringCB_SelectionChanged"/>
            </StackPanel>
        </Grid>
              
        
        <TextBlock Name="FullName"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Right"
                   Margin="20 10"/>
        <ScrollViewer Grid.Row="1">
            <ItemsControl Name ="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Tag="{Binding Id}"
                                Background="{Binding Background}"
                                MouseDown="Border_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="80"
                                        Height="80"
                                        Margin="15 0">
                                    <Image Source="{Binding Photo}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold">
                                      <Run Text="{Binding Manufacturer.Name}" />
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                        
                                    </TextBlock>
                                    <TextBlock >
                                        <Run Text="Категория: "/>
                                        <Run Text="{Binding Subcategory.Category.Name}"
                                               />
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Количество: "/>
                                        <Run Text="{Binding StrQuantity }"/>
                                        <Run Text=" ( "/>
                                         <Run Text=" ) "/>

                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                         <Run Text="Состав: "/>
                                         <Run Text="{Binding Material}"
                                               />
                                    </TextBlock>



                                </StackPanel>
                                <Border Grid.Column="2">
                                    <TextBlock Text="{Binding Cost}">
                                        
                                    </TextBlock>
                                </Border>
                                                 
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Name ="LogOutButton"
                Content="Выйти"
                Grid.Row="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="20 0"
                Click="LogOutButton_Click"
                ></Button>
        <Button Name ="CreateButton"
           Content="Создать"
           Grid.Row="2"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"
           Margin="20 0"
                Visibility="Collapsed"
           Click="CreateButton_Click"
           ></Button>

    </Grid>
</Window>
