<Window x:Class="chudoShoes.AddEditProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопка Назад и ФИО -->
        <DockPanel Grid.Row="0" Margin="0 0 0 10">

            <Button Content="← Назад" Width="80" Height="25" Click="Button_Click"/>
            <TextBlock Name="UserFioText" HorizontalAlignment="Right" FontWeight="Bold"/>
        </DockPanel>

        <!-- Данные товара -->
        <StackPanel Grid.Row="1">
            <TextBlock Name="NameText" FontSize="18" FontWeight="Bold" Margin="0 5"/>
            <TextBlock Name="InfoText" Margin="0 5" TextWrapping="Wrap"/>
            <TextBlock Name="CostText" FontSize="14" FontWeight="Bold" Foreground="Blue" Margin="0 5"/>
            <TextBlock Name="SizesText" Margin="0 5"/>

            <!-- Выбор размера и количества -->
            <TextBlock Text="Выберите размер:" Margin="0 10 0 2"/>
            <ComboBox Name="SizesCombo" DisplayMemberPath="SizeText" SelectionChanged="SizesCombo_SelectionChanged"/>

            <TextBlock Text="Количество:" Margin="0 10 0 2"/>
            <TextBox Name="CountBox" Text="1" Height="25"/>
            <TextBlock Name="MaxCountText" Foreground="Gray" Margin="0 2 0 10"/>
        </StackPanel>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отказаться от заказа" Margin="5" Padding="10 5" Click="Button_Click_1"/>
            <Button Content="Оформить заказ" Background="LightGreen" FontWeight="Bold" Margin="5" Padding="10 5" Click="Button_Click_2"/>
        </StackPanel>
    </Grid>
</Window>